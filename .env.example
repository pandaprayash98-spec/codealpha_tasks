# GEMINI_API_KEY: Automatically injected in AI Studio. Powers AI assistance & fallback translation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_TRANSLATE_API_KEY: Optional Google Cloud Translation v2 API key.
# If provided, Google Cloud Translation v2 API is used directly.
# If omitted or unavailable, LinguaFlow uses server-side Gemini 3.8 Flash for translation.
GOOGLE_TRANSLATE_API_KEY=""

# AI_PROVIDER_API_KEY: Optional alternative AI provider key.
AI_PROVIDER_API_KEY=""

# AI_PROVIDER_MODEL: Default AI model for assistance (default: gemini-3.8-flash)
AI_PROVIDER_MODEL="gemini-3.8-flash"

# Limits
MAX_TRANSLATION_LENGTH=5000
MAX_AI_REQUEST_LENGTH=5000

# Port (configured to 3000 for AI Studio environment)
PORT=3000

